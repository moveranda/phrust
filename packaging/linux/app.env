# What gets packaged, in one place. Every packaging script and the release
# workflow read these values, so renaming the app or switching the packaged
# binary is a one-line change here.

# Reverse-DNS application id. It names the desktop entry, icon, metainfo and
# Flatpak, and must match the Wayland app_id the window sets.
APP_ID=io.github.moveranda.Phrust

# Package and command name users install and run.
APP_NAME=phrust

# Cargo package (under src/) whose release binary is shipped.
CARGO_PACKAGE=hello_triangle

# One-line summary shown by package managers.
APP_SUMMARY="Phrust physics engine demo"
